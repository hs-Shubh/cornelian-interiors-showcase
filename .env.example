# Supabase (required for leads, inquiries, custom orders, blog)
# Get from: Supabase Dashboard → Project Settings → API
# Use ONLY the anon (public) key in the frontend. Never use the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site URL (for sitemap, canonical, OG)
VITE_SITE_URL=https://cornelianinteriors.com

# WhatsApp click-to-chat URL (optional; defaults to the brand number)
VITE_WHATSAPP_URL=https://wa.me/919720130734

# n8n webhook that generates AI room concepts for the Design Studio (optional).
# When unset, the Design Studio saves requests to Supabase (design_requests).
VITE_N8N_DESIGN_WEBHOOK_URL=

# Analytics (optional). GA4 + Meta Pixel load only when these are set.
VITE_GA_ID=
VITE_META_PIXEL_ID=
